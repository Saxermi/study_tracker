{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/studytracker/tasks-import.schema.json",
  "title": "StudyTracker Task Import Envelope v1",
  "type": "object",
  "required": ["format", "batch_id", "tasks"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "studytracker.tasks.v1"},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 150, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["external_id", "subject", "title", "planned_minutes"],
      "additionalProperties": false,
      "properties": {
        "external_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "subject": {"type": "string", "minLength": 1, "maxLength": 60},
        "title": {"type": "string", "minLength": 1, "maxLength": 180},
        "description": {"type": "string", "maxLength": 3000},
        "planned_minutes": {"type": "integer", "minimum": 1, "maximum": 100000},
        "priority": {"type": "string", "enum": ["low", "normal", "high"]},
        "due_date": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "tags": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 50}}
      }
    }
  }
}
